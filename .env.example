T3_VERSION=0.0.28
T3_IMAGE=local/t3code:latest
T3_PLATFORM_NETWORK=t3-agent-platform
T3_SERVER_PORT=3773
T3_SERVER_HOST=0.0.0.0
T3_WORKDIR=/workspace
T3_AUTO_UPDATE=1
T3_UPDATE_CODEX=0
T3_UPDATE_CLAUDE=0
T3_UPDATE_CURSOR=0
T3_UPDATE_GROK=0
T3_UPDATE_OPENCODE=0
T3_INSTALL_DISABLED_PROVIDERS=0
T3_ENABLE_PROVIDER_UPDATE_CHECKS=0
T3_AUTO_BOOTSTRAP_PROJECT_FROM_CWD=1
T3_DEFAULT_THREAD_ENV_MODE=local
T3_NEW_WORKTREES_START_FROM_ORIGIN=0
# Standard MCP bridge to the optional OpenSandbox policy gateway.
T3_SANDBOX_URL=
T3_SANDBOX_TOKEN=
T3_SANDBOX_TOKEN_FILE=
T3_SANDBOX_MCP_RECONCILE=1
T3_HARNESS_SANDBOX_INSTRUCTIONS=1
T3_OPENCODE_SANDBOX_ONLY=0

# Optional autonomous GitHub issue worker. It processes only issues carrying
# agent-ready, opens draft PRs, and never auto-merges. Restrict the fine-grained
# token to the repositories the worker may touch.
T3_ISSUE_WORKER_GITHUB_TOKEN=
T3_ISSUE_WORKER_GITHUB_API_URL=https://api.github.com
T3_ISSUE_WORKER_GITHUB_API_VERSION=2026-03-10
T3_ISSUE_WORKER_GITHUB_SERVER_URL=https://github.com
T3_ISSUE_WORKER_REPOSITORIES=
T3_ISSUE_WORKER_ALLOWED_ACTORS=
T3_ISSUE_WORKER_MODEL=proton/lumo-plus-v1
T3_ISSUE_WORKER_AGENT=github-issue-worker
T3_ISSUE_WORKER_PROMPT_SUFFIX=
T3_ISSUE_WORKER_BRANCH_PREFIX=t3-agent
T3_ISSUE_WORKER_GIT_NAME=t3-issue-worker[bot]
T3_ISSUE_WORKER_GIT_EMAIL=t3-issue-worker[bot]@users.noreply.github.com
T3_ISSUE_WORKER_POLL_SECONDS=60
T3_ISSUE_WORKER_TIMEOUT_SECONDS=7200
T3_ISSUE_WORKER_MAX_CONCURRENT=1
T3_ISSUE_WORKER_MAX_PER_POLL=3
T3_ISSUE_WORKER_MAX_POLL_FAILURES=10
T3_ISSUE_WORKER_MAX_LOG_BYTES=52428800
T3_ISSUE_WORKER_BOOTSTRAP_LABELS=1
T3_ISSUE_WORKER_KEEP_FAILED_DAYS=14
T3_ISSUE_WORKER_ALLOW_CI_CHANGES=0
T3_ISSUE_WORKER_LABEL_READY=agent-ready
T3_ISSUE_WORKER_LABEL_RUNNING=agent-running
T3_ISSUE_WORKER_LABEL_PR=agent-pr-opened
T3_ISSUE_WORKER_LABEL_COMPLETE=agent-complete
T3_ISSUE_WORKER_LABEL_NEEDS_HUMAN=agent-needs-human
T3_ISSUE_WORKER_OPENCODE_CONFIG_SOURCE=/config/opencode
T3_ISSUE_WORKER_DATA_ROOT=/data/issue-worker
T3_ISSUE_WORKER_WORKSPACE_ROOT=/workspace

# Optional standalone sandbox stack (sandbox/docker-compose.example.yml).
OPEN_SANDBOX_API_KEY=
T3_SANDBOX_GATEWAY_TOKEN=
T3_SANDBOX_GATEWAY_IMAGE=ghcr.io/traktuner/docker-t3-code:sandbox-gateway
T3_SANDBOX_AGENT_IMAGE=ghcr.io/traktuner/docker-t3-code:agent-base
T3_SANDBOX_HOST_WORKSPACE_ROOT=/absolute/host/workspace/root
T3_SANDBOX_RUNTIME_NETWORK=t3-sandbox-runtime
T3_SANDBOX_DOCKER_NETWORK_MODE=
T3_SANDBOX_CACHE_VOLUME=t3-sandbox-agent-cache
T3_SANDBOX_BIND_ADDRESS=127.0.0.1
T3_SANDBOX_PORT=8090
T3_SANDBOX_MAX_CONCURRENT=4
T3_SANDBOX_DEFAULT_TTL_SECONDS=7200
T3_SANDBOX_MAX_TTL_SECONDS=28800
T3_SANDBOX_MAX_COMMAND_SECONDS=1800
T3_SANDBOX_MAX_OUTPUT_BYTES=262144
T3_SANDBOX_CPU_LIMIT=4
T3_SANDBOX_MEMORY_LIMIT=8Gi
T3_SANDBOX_DEVCONTAINER_ENABLED=1
T3_SANDBOX_DEVCONTAINER_BUILD_SECONDS=3600
T3_SANDBOX_DEVCONTAINER_FEATURE_PREFIXES=ghcr.io/devcontainers/features/,ghcr.io/devcontainers-extra/features/
T3_SANDBOX_DEVCONTAINER_PLATFORM=linux/amd64
T3_SANDBOX_WORKSPACE_GID=3001
T3_SANDBOX_PORT_RANGE_MIN=40000
T3_SANDBOX_PORT_RANGE_MAX=40200
T3_SANDBOX_PIDS_LIMIT=4096
T3_SANDBOX_EXECD_IMAGE=opensandbox/execd:v1.0.20
T3_SANDBOX_EGRESS_IMAGE=opensandbox/egress:v1.1.3
T3_SANDBOX_EGRESS_MODE=dns
T3_SANDBOX_EGRESS_ALLOW=
T3_SANDBOX_DOCKER_HOST_IP=host.docker.internal
T3_SANDBOX_APPARMOR_PROFILE=
T3_SANDBOX_SECCOMP_PROFILE=
T3_SANDBOX_SECURE_RUNTIME=
T3_SANDBOX_DOCKER_RUNTIME=

# Optional XcodeBuildMCP worker on a Mac that sees the same repository tree.
T3_XCODE_SSH_HOST=
T3_XCODE_SSH_PORT=22
T3_XCODE_SSH_IDENTITY_FILE=/data/home/.ssh/t3-xcode
T3_XCODE_SSH_KNOWN_HOSTS=/data/home/.ssh/known_hosts
T3_XCODE_SSH_OPTIONS_JSON=
T3_XCODE_LOCAL_WORKSPACE_ROOT=/workspace
T3_XCODE_REMOTE_WORKSPACE_ROOT=
T3_XCODE_DERIVED_DATA_ROOT=
T3_XCODE_ENABLED_WORKFLOWS=

T3_UID=1000
T3_GID=1000
T3_WORKSPACE_GID=1000
T3_CONFIG_DIR=./config
T3_WORKSPACE_HOST=./workspace
T3_STATE_HOST=./data/t3
T3_HOME_HOST=./data/home
T3_CODEX_HOME_HOST=./data/codex
T3_CLAUDE_HOME_HOST=./data/claude-home

T3_PROVIDER_CODEX=1
T3_PROVIDER_CLAUDE=1
T3_PROVIDER_CURSOR=1
T3_PROVIDER_GROK=1
T3_PROVIDER_OPENCODE=1
T3_PROVIDER_MODEL_PREFERENCES_JSON=

T3_CODEX_DISPLAY_NAME=Codex
T3_CODEX_BINARY_PATH=codex
T3_CODEX_HOME_PATH=/data/codex
T3_CODEX_SHADOW_HOME_PATH=
T3_CODEX_CONFIG_DIR_SOURCE=
T3_CODEX_CUSTOM_MODELS=
T3_CODEX_HIDDEN_MODELS=
T3_CODEX_MODEL_ORDER=
T3_CODEX_ENV_JSON=

T3_CLAUDE_DISPLAY_NAME=Claude
T3_CLAUDE_BINARY_PATH=claude
T3_CLAUDE_HOME_PATH=/data/claude-home
T3_CLAUDE_LAUNCH_ARGS=
T3_CLAUDE_CONFIG_DIR_SOURCE=
T3_CLAUDE_CUSTOM_MODELS=
T3_CLAUDE_HIDDEN_MODELS=
T3_CLAUDE_MODEL_ORDER=
T3_CLAUDE_ENV_JSON=

T3_CURSOR_DISPLAY_NAME=Cursor
T3_CURSOR_BINARY_PATH=t3-cursor-agent
T3_CURSOR_REAL_BINARY_PATH=agent
T3_CURSOR_API_ENDPOINT=
T3_CURSOR_CUSTOM_MODELS=
T3_CURSOR_HIDDEN_MODELS=
T3_CURSOR_MODEL_ORDER=
T3_CURSOR_ENV_JSON=

T3_GROK_DISPLAY_NAME=Grok
T3_GROK_BINARY_PATH=grok
GROK_CONFIG_DIR=/data/home/.grok
T3_GROK_CONFIG_DIR_SOURCE=
T3_GROK_CUSTOM_MODELS=
T3_GROK_HIDDEN_MODELS=
T3_GROK_MODEL_ORDER=
T3_GROK_ENV_JSON=

T3_OPENCODE_DISPLAY_NAME=OpenCode
T3_OPENCODE_BINARY_PATH=opencode
T3_OPENCODE_DEFAULT_MODEL=openai/gpt-5
T3_OPENCODE_MANAGED_SERVER=0
T3_OPENCODE_MANAGED_HOST=127.0.0.1
T3_OPENCODE_MANAGED_PORT=4096
OPENCODE_CONFIG_DIR=/data/home/.config/opencode
T3_OPENCODE_CONFIG_DIR_SOURCE=
T3_OPENCODE_CONFIG_SOURCE=
T3_OPENCODE_CONFIG_PATH=
T3_OPENCODE_CONFIG_CONTENT=
T3_OPENCODE_CONFIG_SYNC_MODE=preserve-mcp
T3_OPENCODE_SERVER_URL=
T3_OPENCODE_SERVER_PASSWORD=
T3_OPENCODE_CUSTOM_MODELS=
T3_OPENCODE_HIDDEN_MODELS=
T3_OPENCODE_MODEL_ORDER=
T3_OPENCODE_ENV_JSON=
# Values: 1/core, docs, all, api, token, 0/off.
T3_OPENCODE_CLOUDFLARE_MCP=1
T3_OPENCODE_CLOUDFLARE_AUTH=auto
T3_OPENCODE_MCP_PRESETS=context7
T3_OPENCODE_MCP_SERVERS_JSON=
T3_OPENCODE_MCP_SERVERS_FILE=

LUMO_API_KEY=
CLOUDFLARE_API_TOKEN=
CF_API_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
CONTEXT7_API_KEY=
OPENAI_API_KEY=
CODEX_ACCESS_TOKEN=
CODEX_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
CURSOR_API_KEY=
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
GROK_DEPLOYMENT_KEY=
GROK_PROXY_URL=
GROK_CHANNEL=
GEMINI_API_KEY=

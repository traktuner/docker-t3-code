{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["proton"],
  "model": "proton/lumo-max",
  "small_model": "proton/lumo-lite",
  "provider": {
    "proton": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lumo",
      "options": {
        "baseURL": "https://lumo.proton.me/api/ai/v1",
        "apiKey": "{env:LUMO_API_KEY}",
        "stream": false
      },
      "models": {
        "lumo-lite": {
          "name": "Lumo Lite",
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 111072, "output": 16384 }
        },
        "lumo-max": {
          "name": "Lumo Max",
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 111072, "output": 16384 }
        }
      }
    }
  }
}

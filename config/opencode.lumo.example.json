{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["proton"],
  "model": "proton/lumo-plus-v1",
  "small_model": "proton/lumo-basic-v1",
  "provider": {
    "proton": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lumo",
      "options": {
        "baseURL": "https://lumo.proton.me/api/ai/v1",
        "apiKey": "{env:LUMO_API_KEY}",
        "stream": false
      },
      "models": {
        "auto": {
          "name": "Lumo Auto",
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 120000, "output": 16384 }
        },
        "lumo-basic-v1": {
          "name": "Lumo Basic",
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 120000, "output": 16384 }
        },
        "lumo-plus-v1": {
          "name": "Lumo Plus",
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 120000, "output": 16384 }
        }
      }
    }
  },
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    }
  }
}

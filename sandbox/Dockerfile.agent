# syntax=docker/dockerfile:1.7

ARG UV_VERSION=latest
FROM golang:1.26.5-bookworm AS go-toolchain
FROM rust:1.96.1-slim-bookworm AS rust-toolchain
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-toolchain

FROM node:26-bookworm

ARG AGENT_UID=1000
ARG AGENT_GID=1000
ARG WORKSPACE_GID=3001
ARG PNPM_VERSION=latest
ARG YARN_VERSION=latest

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/agent \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/cache/bin:/cache/npm-global/bin:/usr/local/go/bin:/usr/local/cargo/bin:/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    NPM_CONFIG_PREFIX=/cache/npm-global \
    NPM_CONFIG_CACHE=/cache/npm-cache \
    PNPM_HOME=/cache/pnpm \
    UV_CACHE_DIR=/cache/uv-cache \
    UV_TOOL_DIR=/cache/uv-tools \
    UV_TOOL_BIN_DIR=/cache/uv-tools/bin \
    PIP_CACHE_DIR=/cache/pip \
    CARGO_HOME=/cache/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    GOMODCACHE=/cache/go/pkg/mod \
    GOCACHE=/cache/go/build \
    GRADLE_USER_HOME=/cache/gradle \
    MAVEN_CONFIG=/cache/maven \
    XCODEBUILDMCP_SENTRY_DISABLED=true

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=go-toolchain /usr/local/go /usr/local/go
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
COPY --from=uv-toolchain /uv /uvx /usr/local/bin/

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      bat \
      bfs \
      build-essential \
      ca-certificates \
      chromium \
      clang \
      clang-format \
      cmake \
      curl \
      default-jdk-headless \
      default-mysql-client \
      dnsutils \
      entr \
      fd-find \
      ffmpeg \
      file \
      fonts-dejavu-core \
      fonts-liberation \
      fzf \
      gdb \
      gifsicle \
      git \
      git-lfs \
      gnupg \
      graphviz \
      hyperfine \
      imagemagick \
      iproute2 \
      iputils-ping \
      jpegoptim \
      jq \
      lcov \
      less \
      libheif-examples \
      libimage-exiftool-perl \
      libsox-fmt-all \
      libvips-tools \
      libxml2-utils \
      lldb \
      lsof \
      make \
      mediainfo \
      netcat-openbsd \
      ninja-build \
      openssh-client \
      openssl \
      optipng \
      p7zip-full \
      pandoc \
      patch \
      pkg-config \
      pngquant \
      poppler-utils \
      postgresql-client \
      procps \
      python3 \
      python3-pip \
      python3-venv \
      qpdf \
      redis-tools \
      ripgrep \
      rsync \
      shellcheck \
      shfmt \
      sox \
      sqlite3 \
      strace \
      tesseract-ocr \
      tesseract-ocr-deu \
      tesseract-ocr-eng \
      tmux \
      tree \
      ugrep \
      universal-ctags \
      unzip \
      valgrind \
      webp \
      xxd \
      xvfb \
      yq \
      zbar-tools \
      zip \
      zstd \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && for binary in \
      chromium cwebp dot exiftool ffmpeg ffprobe gh identify mediainfo pandoc \
      pdftoppm qpdf shellcheck shfmt sox tesseract vips Xvfb zbarimg; do \
        command -v "$binary" >/dev/null || { echo "Missing agent tool: $binary" >&2; exit 1; }; \
      done

RUN --mount=type=cache,target=/root/.npm \
    npm install -g --no-audit --no-fund \
      "pnpm@${PNPM_VERSION}" \
      "yarn@${YARN_VERSION}" \
      prettier@latest \
      typescript@latest \
      tsx@latest

RUN userdel -r node 2>/dev/null || true \
    && groupadd --gid "${AGENT_GID}" agent \
    && if getent group "${WORKSPACE_GID}" >/dev/null; then \
         workspace_group="$(getent group "${WORKSPACE_GID}" | cut -d: -f1)"; \
       else \
         groupadd --gid "${WORKSPACE_GID}" workspace; \
         workspace_group=workspace; \
       fi \
    && useradd --create-home --uid "${AGENT_UID}" --gid agent --groups "$workspace_group" --shell /bin/bash agent \
    && mkdir -p /cache /workspace \
    && chmod 0777 /cache \
    && chown -R agent:agent /home/agent /workspace \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && ln -s /usr/bin/batcat /usr/local/bin/bat \
    && git lfs install --system

USER agent
WORKDIR /workspace

CMD ["sleep", "infinity"]

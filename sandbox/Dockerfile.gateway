# syntax=docker/dockerfile:1.7

ARG UV_VERSION=latest
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-toolchain

FROM node:26-bookworm-slim

ARG DEVCONTAINER_CLI_VERSION=0.87.0

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      gnupg \
      python3 \
      python3-pip \
      python3-venv \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
      -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo \"$VERSION_CODENAME\") stable" \
      > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      docker-buildx-plugin \
      docker-ce-cli

RUN --mount=type=cache,target=/root/.npm \
    npm install -g --no-audit --no-fund \
      "@devcontainers/cli@${DEVCONTAINER_CLI_VERSION}"

COPY --from=uv-toolchain /uv /uvx /usr/local/bin/
WORKDIR /opt/t3-sandbox
COPY pyproject.toml uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY src ./src
COPY opensandbox.toml render-opensandbox-config.py opensandbox-healthcheck.py gateway-entrypoint.sh ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

RUN chmod +x /opt/t3-sandbox/render-opensandbox-config.py \
      /opt/t3-sandbox/opensandbox-healthcheck.py \
      /opt/t3-sandbox/gateway-entrypoint.sh \
    && mkdir -p /data/devcontainers

EXPOSE 8090

HEALTHCHECK --interval=20s --timeout=3s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8090/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

# Docker socket access is an administrative capability. The gateway is the only
# custom service that receives it; coding sandboxes and T3 remain non-root.
ENTRYPOINT ["/opt/t3-sandbox/gateway-entrypoint.sh"]
CMD ["uvicorn", "t3_sandbox_gateway.api:app", "--host", "0.0.0.0", "--port", "8090", "--no-access-log"]
